# Required. UI_PASSWORD must contain at least 8 characters.
UI_USERNAME=admin
UI_PASSWORD=replace-with-a-strong-password

# Optional authentication settings.
UI_SESSION_HOURS=12
UI_COOKIE_SECURE=false

# Enable only behind a trusted reverse proxy that sets client IP headers.
TRUST_PROXY=false

# Existing UI server settings.
HOST=0.0.0.0
PORT=8090
