{
  "name": "website-email-crawler-node",
  "version": "1.0.0",
  "private": true,
  "description": "HTTP-first website email crawler with Playwright fallback and XLSX input/output",
  "type": "module",
  "scripts": {
    "crawl": "tsx src/cli.ts",
    "ui": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@crawlee/basic": "^3.18.1",
    "@crawlee/core": "^3.18.1",
    "@crawlee/playwright": "^3.18.1",
    "cheerio": "^1.1.2",
    "commander": "^14.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "got-scraping": "^4.2.1",
    "multer": "^2.4.0",
    "playwright": "^1.63.0",
    "robots-parser": "^3.0.1",
    "sax": "^1.6.1",
    "unzipper": "^0.12.5",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.14",
    "@types/sax": "^1.2.7",
    "@types/unzipper": "^0.10.11",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
